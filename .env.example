# ============================================================================
# SEZ API – konfigurace
# Zkopírujte tento soubor jako .env a doplňte hodnoty.
# ============================================================================

# ---------- Povinné ----------

# Client ID registrovaný v JSU (formát: IČO_Název)
SEZ_CLIENT_ID=25488627_KrajskaZdravotniVerejnyTest

# Cesta k certifikátu EZCA II (.pfx / .p12)
SEZ_P12_PATH=/cesta/ke/certifikatu.pfx

# Heslo k certifikátu
SEZ_P12_PASSWORD=tajne-heslo

# ---------- Volitelné ----------

# UID certifikátu z EZCA (kid claim v JWT). Pokud není zadáno, použije se
# SubjectKeyIdentifier z certifikátu.
SEZ_CERT_UID=

# URL API Gateway (výchozí: T2 testovací prostředí)
# T2:  https://gwy-ext-sec-t2.csez.cz
# Prod: https://gwy-ext-sec.csez.cz
SEZ_GATEWAY=https://gwy-ext-sec-t2.csez.cz

# Host a port webového rozhraní
SEZ_HOST=0.0.0.0
SEZ_PORT=8000

# ---------- SÚKL – eRecept / CÚER a DLP (volitelné) ----------
# eRecept je samostatný systém SÚKL (SOAP, verze 202501A, epreskripce.gov.cz).
# Bez registračního ID a endpointu běží integrace v režimu SIMULACE.
# DLP (databáze léčivých přípravků) jsou veřejná data – fungují i bez konfigurace.

# Zapnutí SÚKL sekce (výchozí: true)
SUKL_ENABLED=true

# Verze datového rozhraní eReceptu
SUKL_INTERFACE_VERSION=202501A

# Textová identifikace výrobce SW (posílá se v požadavcích)
SUKL_VYROBCE=SEZ API Web (mirapavlicek/sezapi)

# Registrační ID přidělené SÚKL (12 znaků eRecept). Prázdné = SIMULACE.
SUKL_REG_ID=

# Endpoint eRecept SOAP rozhraní. Prázdné = SIMULACE.
SUKL_ERECEPT_ENDPOINT_TEST=
SUKL_ERECEPT_ENDPOINT=

# Certifikát pro mTLS k eReceptu (volitelné). Když je prázdné, použije se
# certifikát aktivního CSEZ/EZCA klienta (např. krajska_zdravotni.pfx).
# Lze nastavit i vlastní SÚKL cert (PFX/P12), např. pytloun.pfx.
SUKL_CERT_PATH=
SUKL_CERT_PASSWORD=

# DLP – balík otevřených dat a lokální cache adresář.
# "auto" (výchozí) najde aktuální balík v katalogu – SÚKL ho publikuje s datem
# v názvu (SOD<RRRRMMDD>/DLP<RRRRMMDD>.zip), takže pevná URL po aktualizaci
# přestane platit. Prázdná hodnota vypne živé načítání (použijí se vzorky).
# SUKL_DLP_URL=auto
# SUKL_DLP_KATALOG=https://opendata.sukl.cz/?q=katalog/databaze-lecivych-pripravku-dlp
SUKL_DLP_CACHE_DIR=/tmp/sukl_dlp

# ---------- ÚZIS – NZIS (volitelné) ----------
# NRPZS = veřejné REST API (funguje bez certifikátu). NZR/hlášení = cert ÚZIS/EREG,
# bez konfigurace běží v režimu SIMULACE.
UZIS_ENABLED=true
UZIS_NRPZS_URL=https://nrpzs.uzis.cz/api/v1
# ÚZIS eReg REST API (api.uzis.cz) – služba ObsazenostLůžek atd. Dokumentace: apidoc.uzis.cz
UZIS_EREG_BASE=https://api.uzis.cz
UZIS_EREG_BASE_TEST=https://apitest.uzis.cz
# Endpoint pro hlášení do Národních zdravotnických registrů (prázdné = SIMULACE)
UZIS_NZR_ENDPOINT_TEST=
UZIS_NZR_ENDPOINT=
# Certifikát ÚZIS/EREG (prázdné = použije se cert CSEZ/EZCA klienta)
UZIS_CERT_PATH=
UZIS_CERT_PASSWORD=

# ---------- Produkce (volitelné) ----------
# Heslo pro přepnutí na produkci v webovém rozhraní
# SEZ_PROD_PASSWORD=

# Certifikát a přístupy pro produkční prostředí
# SEZ_PROD_CLIENT_ID=
# SEZ_PROD_P12_PATH=
# SEZ_PROD_P12_PASSWORD=
# SEZ_PROD_CERT_UID=

# ---------- Interní API: časové limity ----------
# Volající (NIS) mívá timeout kolem 5 s. Rozpočet je vynucený tvrdě –
# timeout každého volání se krátí na zbývající čas a opakování se
# nezahájí, pokud by rozpočet přeteklo.
# SEZ_ZTOTOZNENI_BUDGET_MS=4000
# Verze API KRP pro ztotožnění. v1 vypnuto 14. 8. 2026, provoz v2 se
# ukončuje – standardně se volá v3. "v2" vrátí dřívější chování.
# SEZ_INTERNAL_KRP_VERZE=v3
# SEZ_INTERNAL_HTTP_TIMEOUT=3
# SEZ_INTERNAL_MAX_RETRIES=1
# SEZ_INTERNAL_RETRY_BACKOFF=0.25
# Souběžnost: kolik volání na bránu smí běžet najednou (na worker)
# a kolik položek dávky se zpracovává současně.
# SEZ_INTERNAL_POOL_SIZE=8
# SEZ_DAVKA_SOUBEZNOST=4

# ---------- Převzetí certifikátu z centrální distribuce ----------
# POST /internal/v1/certifikat uloží certifikát sem a rovnou ho zařadí
# do provozu; po restartu se použije přednostně před SEZ_PROD_P12_PATH.
# Adresář musí být zapisovatelný procesem a mimo repozitář.
# Výchozí: <adresář SEZ_PROD_P12_PATH>/certstore, jinak ./data/certs
# SEZ_CERT_STORE_DIR=/var/lib/sezapi/certs
# Vlastní klíč pro API distribuce certifikátů (jinak SEZ_INTERNAL_API_KEY)
# SEZ_CERT_API_KEY=

# ---------- Automatická aktualizace certifikátu z distribuce ----------
# Aplikace se sama zeptá distribučního API (IRIS), jestli pro nás není nový
# certifikát, a novější si nasadí bez restartu. Hodnoty odsud jsou jen
# VÝCHOZÍ – za běhu je přepisuje nastavení z GUI (sekce „EZCA Správa cert.“ →
# Automatická aktualizace), které se ukládá do úložiště certifikátů.
# SEZ_CERT_DIST_URL=https://iris.example.local/api/ez/certificate
# SEZ_CERT_DIST_USER=
# SEZ_CERT_DIST_PASSWORD=
# Jak často se ptát (hodiny); 24 = jednou denně.
# SEZ_CERT_DIST_INTERVAL_H=24
# Zapnutí periodické kontroly (bez URL se nespustí ani při 1).
# SEZ_CERT_DIST_ENABLED=0
# Ověřování TLS distribučního serveru: 1/0 nebo cesta k CA bundle.
# Interní IRIS bývá podepsaný firemní CA, kterou systém nezná.
# SEZ_CERT_DIST_VERIFY=1
# SEZ_CERT_DIST_TIMEOUT=30
# Po nasazení ověřit certifikát reálným voláním brány (rollback při selhání).
# SEZ_CERT_DIST_OVERIT_VOLANIM=1
# SEZ_CERT_DIST_PROSTREDI=PROD
# Který záznam z distribuce je náš. Prázdné = odvodí se z client_id
# (00064203_NIS2 → IČO 00064203, služba NIS2). Zabraňuje nasazení
# certifikátu jiné služby nebo subjektu.
# SEZ_CERT_DIST_SLUZBA=
# SEZ_CERT_DIST_ICO=

# ---------- NCPeH – přeshraniční pacientský souhrn (volitelné) ----------
# NCPeH (Národní kontaktní místo pro el. zdravotnictví, provozuje Kraj
# Vysočina) – výměna pacientského souhrnu v rámci MyHealth@EU / eHDSI.
# Připojení: žádost datovou schránkou MZČR (x2de458) + dotazník
# www.nixzd.cz/dotaznik; PPT po registraci IP adres, PROD jen z CMS2/AKČR.
# Bez endpointu běží integrace v režimu SIMULACE.

# Zapnutí NCPeH sekce (výchozí: true)
NCPEH_ENABLED=true

# Endpoint ClientConnectorProxy na PPT prostředí (přidělí tým NCPeH)
NCPEH_PPT_URL=

# Endpoint na PROD (dostupný jen z CMS2 / sítě AKČR)
NCPEH_PROD_URL=

# ---------- HTTP hlavičky dle API endpointy (21. 7. 2026) ----------
# User-Agent je POVINNÝ od 1. 9. 2026, formát:
#   název-aplikace/verze (Test|Prod; výrobceSW[; další informace])
# Prostředí (Test/Prod) doplní klient automaticky dle zvoleného prostředí.
SEZ_APP_NAME=sez-api
SEZ_VENDOR=Krajska zdravotni a.s.
# Volitelný doplněk do závorky (např. "Nasazeno u ABC")
SEZ_UA_NOTE=

# traceparent (W3C Trace Context) – volitelná hlavička; true = posílat
SEZ_SEND_TRACEPARENT=false
